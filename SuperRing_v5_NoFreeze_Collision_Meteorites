-- ── Drag (con límites de pantalla — no se puede arrastrar fuera) ────────
local dragging    = false
local moved       = false
local dragOrigin  = Vector2.zero
local panelOrigin = UDim2.new()
local THRESHOLD   = 6

header.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.Touch
    or inp.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging    = true
        moved       = false
        dragOrigin  = inp.Position
        panelOrigin = panel.Position
    end
end)

UIS.InputChanged:Connect(function(inp)
    if not dragging then return end
    if inp.UserInputType == Enum.UserInputType.Touch
    or inp.UserInputType == Enum.UserInputType.MouseMovement then
        local d = inp.Position - dragOrigin
        if not moved and (math.abs(d.X) > THRESHOLD or math.abs(d.Y) > THRESHOLD) then
            moved = true
        end
        if moved then
            local vp = (camera and camera.ViewportSize) or Vector2.new(800, 600)
            local maxX = math.max(0, vp.X - panel.AbsoluteSize.X)
            local maxY = math.max(0, vp.Y - panel.AbsoluteSize.Y)
            local newX = math.clamp(panelOrigin.X.Offset + d.X, 0, maxX)
            local newY = math.clamp(panelOrigin.Y.Offset + d.Y, 0, maxY)
            panel.Position = UDim2.new(0, newX, 0, newY)
        end
    end
end)

UIS.InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.Touch
    or inp.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
        moved    = false
    end
end)

