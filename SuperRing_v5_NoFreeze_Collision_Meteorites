local PANEL_H_MIN, PANEL_H_MAX, PANEL_H_RATIO = 300, 460, 0.68

local function computePanelSize()
    local vp = (camera and camera.ViewportSize) or Vector2.new(800, 600)
    local w = math.clamp(vp.X * PANEL_W_RATIO, PANEL_W_MIN, PANEL_W_MAX)
    local h = math.clamp(vp.Y * PANEL_H_RATIO, PANEL_H_MIN, PANEL_H_MAX)
    return w, h
end

