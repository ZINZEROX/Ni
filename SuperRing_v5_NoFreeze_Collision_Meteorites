-- ── Helpers (Ring) ────────────────────────────────────────────────────────
local function getCenter()
    local char = targetPlayer and targetPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    return root and root.Position or Vector3.new(0, 3, 0)
end

local function isInCharacter(part)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and part:IsDescendantOf(p.Character) then
            return true
        end
    end
    return false
end

--// Descarta partes conectadas rígidamente a otra cosa (Weld/Motor6D/
--// WeldConstraint/etc). AssemblyLinearVelocity mueve TODO el conjunto
--// conectado, no solo esta parte — si estuviera soldada a una estructura
--// grande, solo esta parte tendría CanCollide=false mientras el resto
--// sigue sólido y viaja a alta velocidad. Esa es la causa real de que
--// algunas partes "desaparecieran" (salen del área cargada) y de que
--// el jugador saliera empujado (la estructura sólida lo golpea).
local function isStandalonePart(part)
    local ok, connected = pcall(function() return part:GetConnectedParts(true) end)
    if not ok or not connected then return false end
    for _, other in ipairs(connected) do
        if other ~= part then
            return false
        end
    end
    return true
end

--// GAP REAL que isStandalonePart NO cubre (confirmado con la
--// documentación oficial de Roblox): GetConnectedParts SOLO detecta
--// Weld · Snap · ManualWeld · Motor · Motor6D · WeldConstraint. NO
--// detecta HingeConstraint, RigidConstraint, BallSocketConstraint,
--// PrismaticConstraint, CylindricalConstraint, UniversalConstraint,
--// SpringConstraint, TorsionSpringConstraint, RopeConstraint ni
--// RodConstraint — hay reportes de otros desarrolladores topándose con
--// este mismo hueco en autos (la rueda unida solo por HingeConstraint
--// no aparece como "conectada"). Sin este chequeo extra, el Ring podría
--// agarrar, por ejemplo, la rueda de un auto sin tocar el chasis, y al
--// moverla a alta velocidad arrastra o desarma el vehículo entero —
--// el mismo problema que el chequeo de arriba ya evitaba, pero por una
--// vía que ese chequeo no cubre.
--//
--// Se usa IsA("Constraint") (clase abstracta real, confirmada) en vez
--// de una lista manual de nombres, para no quedar corto si Roblox agrega
--// un tipo de constraint nuevo. Solo cuenta si el constraint está
--// Enabled y tiene AMBOS Attachment0/Attachment1 apuntando a dos partes
--// distintas — así se descartan solos los constraints de una sola
--// parte (VectorForce, AlignPosition en modo mundo, etc.) y también
--// NoCollisionConstraint/WeldConstraint (que no usan Attachment0/1, y
--// WeldConstraint ya está cubierto arriba).
local function buildConstrainedLookup(descendants)
    local constrained = {}
    local scanned = 0
    for _, inst in ipairs(descendants) do
        if inst:IsA("Constraint") then
            local okEnabled, enabled = pcall(function() return inst.Enabled end)
            if okEnabled and enabled ~= false then
                local okA0, a0 = pcall(function() return inst.Attachment0 end)
                local okA1, a1 = pcall(function() return inst.Attachment1 end)
                if okA0 and okA1 and a0 and a1 then
                    local p0, p1 = a0.Parent, a1.Parent
                    if p0 and p1 and p0 ~= p1 and p0:IsA("BasePart") and p1:IsA("BasePart") then
                        constrained[p0] = true
                        constrained[p1] = true
                    end
                end
            end
        end
        scanned = scanned + 1
        if scanned >= 64 then
            scanned = 0
            task.wait()
            if not active then return constrained end
        end
    end
    return constrained
end

--// Prepara una parte para el efecto. Devuelve true solo si se pudo
--// aplicar de forma segura — si falla, la parte NO se agrega al ring.
local function preparePart(part)
    local ok = pcall(function()
        -- El Ring conserva colisión durante todo el efecto, incluidos los
        -- meteoritos que deben impactar contra el jugador.
        part.CanCollide = true
        part.Massless   = true
    end)
    return ok
end

local function isEligible(part, alreadyManaged, constrained)
    if not part:IsA("BasePart") then return false end
    if part.Anchored then return false end
    if alreadyManaged[part] then return false end
    if isInCharacter(part) then return false end
    if not isStandalonePart(part) then return false end
    if constrained[part] then return false end
    return true
end

local function collectParts()
    managedParts = {}
    local seen = {}
    local descendants = workspace:GetDescendants()
    local constrained = buildConstrainedLookup(descendants)
    if not active then return end

    local scanned = 0
    for _, part in ipairs(descendants) do
        if #managedParts >= CFG.maxParts then break end
        if isEligible(part, seen, constrained) then
            if preparePart(part) then
                table.insert(managedParts, part)
                seen[part] = true
            end
        end
        scanned = scanned + 1
        if scanned >= 64 then
            scanned = 0
            task.wait()
            if not active then return end
        end
    end
end

--// Relleno periódico: si partes dejaron de ser válidas (destruidas,
--// recogidas, conectadas a algo mientras estaban en el ring, etc.),
--// las libera y busca reemplazos nuevos para mantener el ring lleno.
local function topUpParts()
    if not active then return end
    local descendants = workspace:GetDescendants()
    local constrained  = buildConstrainedLookup(descendants)
    if not active then return end

    -- Purga referencias muertas y libera partes que dejaron de ser
    -- standalone (alguien las soldó/conectó mientras estaban en el ring):
    -- si se las deja adentro, seguirían arrastrando lo que se les conectó.
    local alive = {}
    local seen  = {}
    local scanned = 0
    for _, part in ipairs(managedParts) do
        if part and part.Parent then
            if constrained[part] or not isStandalonePart(part) then
                pcall(function()
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.CanCollide = true
                    part.Massless   = false
                end)
            else
                table.insert(alive, part)
                seen[part] = true
            end
        end
        scanned = scanned + 1
        if scanned >= 32 then
            scanned = 0
            task.wait()
            if not active then return end
        end
    end
    managedParts = alive

    if #managedParts >= CFG.maxParts then return end

    scanned = 0
    for _, part in ipairs(descendants) do
        if #managedParts >= CFG.maxParts then break end
        if isEligible(part, seen, constrained) then
            if preparePart(part) then
                table.insert(managedParts, part)
                seen[part] = true
            end
        end
        scanned = scanned + 1
        if scanned >= 64 then
            scanned = 0
            task.wait()
            if not active then return end
        end
    end
end

local function restoreParts()
    for _, part in ipairs(managedParts) do
        if part and part.Parent then
            pcall(function()
                part.AssemblyLinearVelocity = Vector3.zero
                part.CanCollide = true
                part.Massless   = false
            end)
        end
    end
    managedParts = {}
end

local function startRing()
    collectParts()
    if not active then
        restoreParts()
        return
    end
    pcall(function() sethiddenproperty(lp, "SimulationRadius", math.huge) end)

    if heartbeatCon then heartbeatCon:Disconnect() end
    heartbeatCon = RS.Heartbeat:Connect(function(dt)
        if not active then return end
        t = t + dt
        local n = #managedParts
        if n == 0 then return end
        local center = getCenter()
        local style  = STYLES[styleIdx]
        if not style then return end
        for i, part in ipairs(managedParts) do
            if part and part.Parent then
                local target = style.fn(i, n, t, center)
                local vel    = target - part.Position
                local mag    = vel.Magnitude
                if mag > 0.01 then
                    pcall(function()
                        part.AssemblyLinearVelocity = (vel / mag) * math.min(mag * 9, CFG.force)
                    end)
                end
            end
        end
    end)

    if topUpCon then topUpCon:Disconnect() end
    topUpCon = task.spawn(function()
        while active do
            task.wait(3)
            if active and not topUpBusy then
                topUpBusy = true
                pcall(topUpParts)
                topUpBusy = false
            end
        end
    end)
end

local function stopRing()
    if heartbeatCon then
        heartbeatCon:Disconnect()
        heartbeatCon = nil
    end
    topUpCon = nil -- el while active dentro del task.spawn corta solo
    topUpBusy = false
    restoreParts()
end

-- ── Fly Car ═════════════════════════════════════════════════════════════
--// POR QUÉ ESTO NO SE DESARMA (a diferencia de aplicar velocidad directa):
--// Un auto normal tiene las ruedas unidas al chasis con HingeConstraint,
--// que NO es una unión rígida — es una física que "persigue" al chasis
--// cada frame. Si el chasis salta de golpe a alta velocidad, esa
--// persecución falla y la rueda se queda atrás: el modelo se desarma.
--//
--// La solución: ANCLAR todas las piezas del modelo mientras vuela, y
--// recalcular manualmente el CFrame de cada una, cada frame, a partir
--// de su posición relativa original respecto a la pieza principal
--// (flyPrimary). Con esto ya no depende de NINGUNA física — ni Weld,
--// ni Motor6D, ni HingeConstraint — así que es matemáticamente
--// imposible que se separe, sin importar cuántas piezas tenga.

local function findSeatModel()
    local char = lp.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or not hum.SeatPart then return nil end

    local seat  = hum.SeatPart
    local model = seat:FindFirstAncestorOfClass("Model") or seat.Parent
    return model
end

local function findLookAtModel()
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local cam  = workspace.CurrentCamera
    if not root or not cam then return nil end

    local origin    = cam.CFrame.Position
    local direction = cam.CFrame.LookVector * 300

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char }

    local result = workspace:Raycast(origin, direction, params)
    if not result or not result.Instance then return nil end

    local model = result.Instance:FindFirstAncestorOfClass("Model")
    return model
end

--// Junta todas las BasePart de un modelo, sin superar FLYCFG.maxParts.
local function gatherModelParts(model)
    local parts = {}
    for _, inst in ipairs(model:GetDescendants()) do
        if inst:IsA("BasePart") then
            table.insert(parts, inst)
            if #parts >= FLYCFG.maxParts then break end
        end
    end
    if model:IsA("BasePart") then
        table.insert(parts, model)
    end
    return parts
end

local flyStatusLabel = nil -- referencia asignada más abajo, al crear la GUI

local function setFlyStatus(text, color)
    if flyStatusLabel then
        flyStatusLabel.Text = text
        if color then flyStatusLabel.TextColor3 = color end
    end
end

local function stopFlyCar()
    if flyHeartbeatCon then
        flyHeartbeatCon:Disconnect()
        flyHeartbeatCon = nil
    end

    for part, orig in pairs(flyOriginal) do
        if part and part.Parent then
            pcall(function()
                part.Anchored   = orig.Anchored
                part.CanCollide = orig.CanCollide
            end)
        end
    end

    flyOffsets  = {}
    flyOriginal = {}
    flyModel    = nil
    flyPrimary  = nil
    flyActive   = false
    setFlyStatus("Sin objetivo", Color3.fromRGB(190, 193, 202))
end

local function startFlyCar(model)
    if not model then
        setFlyStatus("No se encontró ningún modelo", Color3.fromRGB(255, 150, 150))
        return
    end

    if flyActive then stopFlyCar() end

    local parts = gatherModelParts(model)
    if #parts == 0 then
        setFlyStatus("El modelo no tiene partes", Color3.fromRGB(255, 150, 150))
        return
    end

    --// Pieza principal: PrimaryPart si está seteado, si no la más grande
    --// (más grande = ancla más estable visualmente, menos "bamboleo").
    local primary = model.PrimaryPart
    if not primary or not table.find(parts, primary) then
        local bestVolume = -1
        for _, part in ipairs(parts) do
            local size = part.Size
            local vol  = size.X * size.Y * size.Z
            if vol > bestVolume then
                bestVolume = vol
                primary    = part
            end
        end
    end
    if not primary then
        setFlyStatus("No se pudo elegir pieza principal", Color3.fromRGB(255, 150, 150))
        return
    end

    flyModel   = model
    flyPrimary = primary
    flyCFrame  = primary.CFrame
    flyOffsets = {}
    flyOriginal = {}

    for _, part in ipairs(parts) do
        flyOriginal[part] = { Anchored = part.Anchored, CanCollide = part.CanCollide }
        flyOffsets[part]  = primary.CFrame:ToObjectSpace(part.CFrame)
        pcall(function()
            part.Anchored   = true
            part.CanCollide = false
        end)
    end

    flyActive = true
    setFlyStatus("Volando: " .. model.Name, Color3.fromRGB(220, 255, 225))

    if flyHeartbeatCon then flyHeartbeatCon:Disconnect() end
    flyHeartbeatCon = RS.Heartbeat:Connect(function(dt)
        if not flyActive then return end

        local turnInput = (flyKeys.D and 1 or 0) - (flyKeys.A and 1 or 0)
        local moveInput  = (flyKeys.W and 1 or 0) - (flyKeys.S and 1 or 0)
        local vertInput  = (flyKeys.Up and 1 or 0) - (flyKeys.Down and 1 or 0)

        if turnInput ~= 0 then
            flyCFrame = flyCFrame * CFrame.Angles(0, -turnInput * FLYCFG.turnSpeed * dt, 0)
        end

        local moveDelta = Vector3.zero
        if moveInput ~= 0 then
            moveDelta = flyCFrame.LookVector * moveInput * FLYCFG.moveSpeed * dt
        end
        if vertInput ~= 0 then
            moveDelta = moveDelta + Vector3.new(0, vertInput * FLYCFG.vertSpeed * dt, 0)
        end

        if moveDelta.Magnitude > 0 then
            flyCFrame = flyCFrame + moveDelta
        end

        for part, offset in pairs(flyOffsets) do
            if part and part.Parent then
                part.CFrame = flyCFrame * offset
            end
        end
    end)
end

local function toggleFlyCar()
    if flyActive then
        stopFlyCar()
        return
    end
    local model = findSeatModel() or findLookAtModel()
    startFlyCar(model)
end

